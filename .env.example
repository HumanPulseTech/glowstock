PORT=8087
NODE_ENV=development
TRUST_PROXY=false
DEV_HTTPS=false
DEV_HTTPS_PFX=./certs/glowstock-dev.pfx
DEV_HTTPS_PFX_PASSWORD=glowstock-dev
SESSION_SECRET=replace_with_a_random_32_character_minimum_secret
DB_HOST=localhost
DB_USER=glowstock
DB_PASSWORD=replace_me
DB_NAME=glowstock
BREVO_API_KEY=replace_me
PUBLIC_URL=https://glowstock.fr
# Clés Stripe : laisse vides tant que le compte Stripe n'est pas prêt.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SERVER_LOG_DIR=./logs

# Pilote caisse séparé. Ne pas activer sur la production fiscale.
# Pilote simulation : même activé, réservé aux comptes avec access_admin + manage_products.
CAISSE_ENABLED=false
CAISSE_SERVICE_URL=https://caisse-interne.example.test
CAISSE_BRIDGE_SECRET=
# Uniquement réseau privé isolé de test; HTTPS requis sinon.
CAISSE_ALLOW_PRIVATE_HTTP=false
